    // Function definition

    fun getPending(
        admin: UserMembersClass,
        onComplete: (List<UserMembersClass>) -> Unit
    ) {
        // If user is not admin, it won't work.
        if (user !is AdminSubclass) {
            onComplete(emptyList())
            return
        }
        // If user is admin, then call admin.getPendingAccounts
        // It returns a list of uids.
        // Convert that into a list of UserMembersClass
        user.getPendingAccounts { pendingAccounts ->
            if (pendingAccounts.isEmpty()) {
                onComplete(emptyList())
                return@getPendingAccounts
            }
            val pendingUsers = mutableListOf<UserMembersClass>()
            var remaining = pendingAccounts.size
            for (uid in pendingAccounts) {
                val pendingUser = UserMembersClass()
                pendingUser.getUserData(uid) { success ->
                    if (success) {
                        Log.d(
                            "PendingAccounts",
                            "Pending ${pendingUser.thisUserName}, ${pendingUser.thisEmail}, ${pendingUser.thisRole}, ${pendingUser.thisApprovalStatus}"
                        )
                        pendingUsers.add(pendingUser)
                    }

                    remaining--

                    // All async calls finished, i.e. all users have been retrieved.
                    if (remaining == 0) {
                        onComplete(pendingUsers)
                    }
                }
            }
        }
    }


